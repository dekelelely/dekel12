<resources>
    <string name="app_name">Voice to WhatsApp</string>

    <!-- Widget -->
    <string name="widget_label">Dictate to WhatsApp</string>
    <string name="widget_description">Tap to dictate a note and send it to your own WhatsApp chat.</string>
    <string name="widget_content_description">Dictate a WhatsApp note</string>

    <!-- Setup / Settings -->
    <string name="setup_title_first_run">Welcome</string>
    <string name="setup_title_settings">Settings</string>
    <string name="setup_intro">Enter your own WhatsApp number in international format: country code first, no leading 0. Your notes go to your own chat with yourself.</string>

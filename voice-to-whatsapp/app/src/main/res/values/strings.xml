    <string name="warning_too_short">Looks too short. An international number usually has at least 8 digits.</string>
    <string name="error_phone_empty">Enter your number first.</string>
    <string name="confirm_number_title">Save this number?</string>
    <string name="save_anyway">Save anyway</string>
    <string name="edit">Edit</string>
    <string name="save">Save</string>
    <string name="saved">Number saved</string>
    <string name="usage_title">Add the mic widget</string>
    <string name="usage_body">Long-press an empty spot on your home screen, choose Widgets, then “%1$s”, and drag it onto the home screen. Resize it as large as you like, even a whole page.</string>
    <string name="add_widget">Add widget to home screen</string>
    <string name="add_widget_unsupported">Your launcher can’t add widgets for apps. Add it by hand as described above.</string>
